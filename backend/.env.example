# Local PostgreSQL (Docker) — copy to ../.env and fill values
DB_HOST=localhost
DB_PORT=5432
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DB_NAME=fitness_yoda
DB_USERNAME=postgres
DB_PASSWORD=

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/fitness_yoda?schema=public

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Optional — seed admin user (not via public register)
ADMIN_EMAIL=
ADMIN_PASSWORD=

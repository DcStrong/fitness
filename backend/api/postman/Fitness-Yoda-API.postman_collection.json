    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Проверка, что API жив. Ожидается `{ \"status\": \"ok\" }`."
          }

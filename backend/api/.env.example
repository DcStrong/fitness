# Скопируйте в .env: cp .env.example .env (реальные секреты не коммитить).
# Здесь перечислены только переменные, связанные со ссылками-приглашениями.

# Адрес веб-приложения (Flutter web), куда ведёт QR/ссылка приглашения: <base>/i/<token>.
# Локально: flutter run -d chrome --web-port 8080 → http://localhost:8080.
# На VDS задаётся в docker-compose.deploy.yml как https://${APP_HOST}.
INVITE_HTTPS_BASE=http://localhost:8080
# Кастомная схема мобильного приложения: <base>/<token>.
INVITE_SCHEME_BASE=fitnessyoda://invite

# Скопируйте в .env в корне репозитория на сервере: cp deploy/.env.example .env
# Секреты НЕ коммитить. Сгенерировать: openssl rand -hex 32

# Адреса. Нет домена? Используйте IP сервера через sslip.io, например для IP 203.0.113.10:
#   APP_HOST=app.203-0-113-10.sslip.io
#   API_HOST=api.203-0-113-10.sslip.io
APP_HOST=app.example.com
API_HOST=api.example.com

POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Администратор для seed (необязательно)
ADMIN_EMAIL=
ADMIN_PASSWORD=
RUN_SEED=true

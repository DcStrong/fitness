# Скопируйте в .env в корне репозитория на сервере: cp deploy/.env.example .env
# Файл .env с секретами НЕ коммитить и никому не отправлять.
# Случайную строку для пароля/секрета выдаёт команда: openssl rand -hex 32

# --- Адреса ---
# Нет домена? Используйте IP сервера через sslip.io, например для IP 203.0.113.10:
#   APP_HOST=app.203-0-113-10.sslip.io
#   API_HOST=api.203-0-113-10.sslip.io
# Адрес приложения (то, что открывают на телефоне), без https://
APP_HOST=app.example.com
# Адрес сервера (API), без https://
API_HOST=api.example.com

# --- База данных ---
# Postgres ставить не нужно: он поднимается сам в контейнере.
# Пароль придумываете вы сами (например, результат `openssl rand -hex 16`).
# Только буквы и цифры, без спецсимволов (@ : / # %): пароль входит в адрес БД.
# Задаётся при ПЕРВОМ запуске; потом менять нельзя без сброса базы (см. docs/deploy-test-stand.md).
POSTGRES_PASSWORD=change-me

# --- Токены входа ---
# Секрет для подписи access-токенов: вставьте результат `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me
# Секрет для refresh-токенов: другая случайная строка (не копируйте предыдущую).
JWT_REFRESH_SECRET=change-me
# Сколько живёт access-токен (15m = 15 минут); обычно менять не нужно.
JWT_ACCESS_TTL=15m
# Сколько дней живёт refresh-токен (сколько можно не заходить без повторного логина).
JWT_REFRESH_TTL_DAYS=30

# --- Администратор (необязательно) ---
# Email админа, который создастся при старте. Пусто — админ не создаётся.
ADMIN_EMAIL=
# Пароль админа (придумайте свой, от 8 символов). Нужен вместе с ADMIN_EMAIL.
ADMIN_PASSWORD=
# true — при каждом старте API заполняет базу начальными данными (повтор безопасен).
# false — не заполнять. Для тестового стенда оставьте true.
RUN_SEED=true

# --- Хранилище картинок (MinIO) ---
# Аватары и фото портфолио лежат в контейнере minio (volume miniodata).
# Секрет записи: другая случайная строка (`openssl rand -hex 16`), только буквы и цифры.
# Как и пароль Postgres, задаётся при ПЕРВОМ запуске minio; менять потом нельзя без сброса volume miniodata.
S3_SECRET_KEY=change-me
# Имя бакета и ключ записи можно не менять.
S3_BUCKET=media
S3_ACCESS_KEY=minio
# MinIO AIStor Free (образ из quay.io). Нужен файл лицензии: бесплатный ключ на https://www.min.io/download
# («Request License Key» -> Free), положите его на сервер и укажите путь. В git ключ не добавляйте.
MINIO_LICENSE_FILE=/root/minio/minio.license
# MINIO_IMAGE=quay.io/minio/aistor/minio:RELEASE.2026-09-19T17-05-25Z

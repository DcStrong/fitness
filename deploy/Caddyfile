# Домены берутся из .env (APP_HOST / API_HOST). Сертификаты Caddy получает сам.
{$APP_HOST} {
	root * /srv

	# Сжатие: zstd/gzip для js, wasm, json, шрифтов (ttf/otf не сжимаются по умолчанию).
	encode zstd gzip

	# Файлы без хеша в имени — всегда проверять свежесть (ETag), чтобы после деплоя не остаться на старой версии.
	@shell path / /index.html /flutter_bootstrap.js /flutter_service_worker.js /version.json /manifest.json /main.dart.js /main.dart.wasm /main.dart.mjs
	header @shell Cache-Control "no-cache"

	# Тяжёлое и редко меняющееся (canvaskit.wasm, шрифты, ассеты; main.dart.js без хеша, поэтому он выше): кеш на неделю + ETag.
	@heavy path /canvaskit/* /assets/* /icons/*
	header @heavy Cache-Control "public, max-age=604800"

	# Файлы верификации Universal Links / App Links (см. docs/deploy-test-stand.md, раздел про приглашения).
	# Лежат отдельно от /srv; у apple-app-site-association нет расширения, поэтому Content-Type задан явно.
	handle /.well-known/assetlinks.json {
		root * /srv-well-known
		header Content-Type application/json
		header Cache-Control "no-cache"
		file_server
	}
	handle /.well-known/apple-app-site-association {
		root * /srv-well-known
		header Content-Type application/json
		header Cache-Control "no-cache"
		file_server
	}

	# SPA fallback: /i/<token> и любые другие пути отдают index.html (в приложении path-стратегия URL).
	handle {
		try_files {path} /index.html
		file_server
	}
}

{$API_HOST} {
	# Публичное чтение картинок из MinIO: https://API_HOST/files/<bucket>/<key>.
	handle_path /files/* {
		reverse_proxy minio:9000
	}

	# WebSocket (чат, socket.io) проксируется автоматически.
	handle {
		reverse_proxy api:3001
	}
}
